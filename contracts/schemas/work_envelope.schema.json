{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://land-record-system/schemas/work_envelope.schema.json",
  "title": "WorkEnvelope",
  "description": "Pinned once at triage (M2) and never re-resolved downstream. TODO: FR-TRI-09 — idempotence guarantee: a retried message after a model promotion must reproduce its original result, not a new one. Owner: Suchit (services/backend). Consumed by: all services after triage.",
  "type": "object",
  "required": ["envelope_id", "document_id", "page_id", "pinned_at", "model_versions", "config_version"],
  "additionalProperties": false,
  "properties": {
    "envelope_id": { "type": "string", "format": "uuid" },
    "document_id": { "type": "string", "format": "uuid" },
    "page_id": { "type": "string", "format": "uuid" },
    "pinned_at": { "type": "string", "format": "date-time" },
    "model_versions": {
      "type": "object",
      "required": ["triage_classifier", "printed_ocr", "hwr", "confidence_calibrator", "novelty_detector"],
      "additionalProperties": false,
      "properties": {
        "triage_classifier": { "type": "string" },
        "printed_ocr": { "type": "string" },
        "hwr": { "type": "string" },
        "confidence_calibrator": { "type": "string" },
        "novelty_detector": { "type": "string" }
      }
    },
    "config_version": { "type": "string" }
  }
}
