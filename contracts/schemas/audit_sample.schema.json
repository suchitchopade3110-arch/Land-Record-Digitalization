{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://land-record-system/schemas/audit_sample.schema.json",
  "title": "AuditSample",
  "description": "TODO: FR-CNF-06/07. Tharun writes the sampling decision; Suchit records the officer verdict. Owner: Tharun defines the policy (services/modelwork); Suchit persists (services/backend).",
  "type": "object",
  "required": ["id", "extraction_id", "review_task_id", "model_confidence", "officer_verdict", "stratum"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "extraction_id": { "type": "string", "format": "uuid" },
    "review_task_id": { "type": "string", "format": "uuid" },
    "model_confidence": { "type": "number" },
    "officer_verdict": { "type": "string", "enum": ["agree", "disagree", "pending"] },
    "agreed": { "type": ["boolean", "null"] },
    "stratum": { "type": "string", "description": "must match the canonical stratum definition, API-Contracts §6" }
  }
}
